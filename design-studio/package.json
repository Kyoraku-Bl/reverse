{
  "name": "mint-design-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:web": "vite --host 0.0.0.0",
    "build": "vite build",
    "start": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/static-browser.mjs && node tests/local-workspace-browser.mjs && node tests/engine-smoke.mjs",
    "test:video": "node --test tests/video.test.mjs",
    "prebuild": "node scripts/prepare-static.mjs",
    "build:server": "vite build --mode server",
    "predev": "node scripts/prepare-static.mjs",
    "predev:web": "node scripts/prepare-static.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test:static": "node tests/static-browser.mjs",
    "test:browser:server": "npm run build:server && node tests/smoke.mjs && node tests/video-browser.mjs",
    "start:server": "node server/index.mjs",
    "dev:server": "concurrently -k -n api,web \"node --watch server/index.mjs\" \"vite --mode server --host 0.0.0.0\"",
    "prebuild:server": "node scripts/prepare-fonts.mjs",
    "predev:server": "node scripts/prepare-fonts.mjs"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@fontsource-variable/noto-sans-arabic": "^5.3.0",
    "express": "^5.3.0",
    "fabric": "^7.4.0",
    "fflate": "^0.8.3",
    "helmet": "^8.3.0",
    "image-size": "^2.0.4",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.468.0",
    "multer": "^2.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sparticuz/chromium": "^153.0.0",
    "concurrently": "^10.0.6",
    "supertest": "^7.3.1",
    "vite": "^6.1.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
