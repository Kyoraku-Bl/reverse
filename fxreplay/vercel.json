{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Access-Control-Allow-Origin", "value": "*" }]
    }
  ],
  "functions": {
    "api/yahoo.js": { "memory": 512, "maxDuration": 20 },
    "api/binance.js": { "memory": 512, "maxDuration": 20 }
  }
}
