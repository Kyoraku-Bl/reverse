{
  "name": "drama-live-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Drama Live Web - IPTV / M3U / Xtream player with all the features of the Drama Live app",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test": "node --experimental-strip-types --no-warnings scripts/smoke.ts && node scripts/dom-smoke.mjs && node scripts/client-smoke.mjs && node scripts/storage-smoke.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "hls.js": "^1.6.15",
    "lucide-react": "^0.545.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.6",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  }
}
