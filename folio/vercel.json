{
  "headers": [
    {
      "source": "/folio-project.zip",
      "headers": [
        { "key": "Content-Type", "value": "application/zip" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"folio-project.zip\"" }
      ]
    }
  ],
  "rewrites": [{ "source": "/((?!folio-project\\.zip$).*)", "destination": "/index.html" }]
}
