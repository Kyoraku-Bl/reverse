{
  "name": "promptworld",
  "version": "0.1.0",
  "private": true,
  "description": "PromptWorld — a cinematic library of 1,300+ copy-paste AI prompts for web design, code, marketing, images and agents.",
  "scripts": {
    "generate": "node scripts/generate-prompts.mjs",
    "predev": "npm run generate",
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "prebuild": "npm run generate",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.15.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
